SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Frontend API Base URL
# (Leave empty on Vercel deployment to use relative /api route automatically)
VITE_API_URL=

