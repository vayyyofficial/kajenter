# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the values for local development.
# In Vercel, set these in: Project Settings -> Environment Variables.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=

# Supabase Production Database & Cloud Storage
# (Obtain from your Supabase Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Frontend API Base URL
# (Leave empty on Vercel deployment to use relative /api route automatically)
VITE_API_URL=
