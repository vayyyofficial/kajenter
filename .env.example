# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the values for local development.
# In Vercel, set these in: Project Settings -> Environment Variables.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=

# Supabase Production Database & Cloud Storage
# (Obtain from your Supabase Project Settings -> API)
