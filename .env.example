# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the values for local development.
# Set these in the deployment provider's environment-variable settings.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Admin authentication (provide an initial password for local first run; use strong random values in production)
JWT_SECRET=
ADMIN_INITIAL_PASSWORD=
CORS_ORIGINS=

# Supabase Production Database & Cloud Storage
# (Obtain from your Supabase Project Settings -> API)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Frontend API Base URL
# (Leave empty on Vercel deployment to use relative /api route automatically)
VITE_API_URL=

# Class Rolling Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_NAME="Class Rolling"
VITE_CLASS_SIZE=26
VITE_TIMEZONE=Asia/Jakarta
